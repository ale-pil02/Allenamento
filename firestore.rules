rules_version = '2';

// App privata: solo l'account Google del proprietario può leggere e scrivere,
// e solo nella propria cartella. Qualunque altro account, anche autenticato,
// viene rifiutato: la pagina lo usa per capire che l'accesso non è autorizzato.
service cloud.firestore {
  match /databases/{database}/documents {

    function proprietario(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'alessandropillot01@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /utenti/{uid} {
      allow read, write: if proprietario(uid);

      // Dati della scheda: scheda, logs, schemi, sessioni, preferenze
      match /dati/{documento} {
        allow read, write: if proprietario(uid);
      }

      // Una foto per documento, così nessuna supera il limite di 1 MiB
      match /foto/{fotoId} {
        allow read, write: if proprietario(uid);
      }
    }

    // Tutto il resto è vietato
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
